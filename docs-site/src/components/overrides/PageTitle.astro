---
/**
 * 自定义页面标题 —— 详细文档页的页头
 * 标题自己承担层级，不再用独立眉标占一行。
 */
const PAGE_TITLE_ID = '_top';

const { entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
const description = entry.data.description;
---

<div class="page-head">
  <h1 id={PAGE_TITLE_ID} data-page-title>{title}</h1>
  {description && <p class="page-desc">{description}</p>}
</div>

<style>
  .page-head {
    position: relative;
    padding-top: 0.35rem;
    margin-bottom: clamp(1.4rem, 3vmin, 2rem);
    min-width: 0;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.55rem, calc(0.7rem + 2.4vw), var(--sl-text-4xl));
    line-height: 1.18;
    letter-spacing: -0.028em;
    font-weight: 700;
    color: var(--sl-color-white);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  :global([data-theme='light']) h1 { color: var(--aw-ink, hsl(225 30% 12%)); }
  .page-desc {
    margin: 0.55rem 0 0;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    max-width: 56ch;
    text-wrap: pretty;
  }
  :global([data-theme='light']) .page-desc { color: hsl(225 12% 38%); }
</style>
