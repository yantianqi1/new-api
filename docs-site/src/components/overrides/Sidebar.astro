---
/**
 * 自定义侧边栏 —— 用项目内的 AwSidebarSublist 替换 Starlight 默认子列表，
 * 以便为每个一级分组注入品牌色图标。折叠态、aria、sessionStorage 持久化
 * 等行为由 SidebarPersister / AwSidebarSublist 完整保留。
 */
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import AwSidebarSublist from '../overrides/AwSidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
const lang = Astro.locals.starlightRoute?.lang || 'zh-CN';
const isZh = !lang.startsWith('en');
const consoleLabel = isZh ? '打开控制台' : 'Open console';
const consoleAria = isZh ? '打开控制台（新窗口）' : 'Open console (opens in a new tab)';
---

<SidebarPersister>
	<AwSidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden aw-mobile-console">
	<a class="aw-console-btn" href="https://api.aiwanai.cc" target="_blank" rel="noreferrer" aria-label={consoleAria}>
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<rect x="3" y="4" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="1.9"/>
			<path d="M7.5 9.5l2.2 2.5-2.2 2.5M12.5 15h4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
		<span>{consoleLabel}</span>
	</a>
</div>
<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	.aw-mobile-console {
		padding: 0.85rem 0.35rem 0.35rem;
	}
	.aw-mobile-console .aw-console-btn {
		width: 100%;
	}
	.aw-mobile-console .aw-console-btn span {
		position: static;
		width: auto;
		height: auto;
		margin: 0;
		clip: auto;
		overflow: visible;
		white-space: nowrap;
	}
</style>
